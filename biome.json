{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": { "noUnreachable": "warn" }
    }
  },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "files": {
    "ignoreUnknown": true,
    "includes": ["src/**/*.ts", "tests/**/*.ts", "!**/node_modules", "!**/build", "!**/coverage"]
  }
}
